# Copy to .env (git-ignored). docker compose reads it for the ${...} variables in
# docker-compose.yml. Service secrets go in backend/.env and frontend/.env instead.
# Image tag used for both aliakbarzaidi/cipher-eclipse-* images.
TAG=latest
# blocking | background | skip
VULNDB_BUILD_MODE=blocking
# 2002 = full NVD history. 2018 gives a much faster dev build.
VULNDB_START_YEAR=2002
# 1 = build only from feeds already copied into the volume's raw/ folder
VULNDB_OFFLINE=0
NEXT_PUBLIC_API_URL=http://localhost:8000
