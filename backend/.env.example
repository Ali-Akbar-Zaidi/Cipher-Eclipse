# Copy to backend/.env (git-ignored). Loaded into the backend container by docker compose.
# LLM used for the executive summary (Claude Messages API). Keep real keys out of git.
# Leave LLM_API_KEY empty to use the deterministic template summary instead.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high
LLM_EFFORT=medium
# Logging verbosity for the API: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
# Whole-scan time limit and concurrent scans allowed (free API tiers)
SCAN_TIMEOUT_SECONDS=240
MAX_CONCURRENT_SCANS=2
